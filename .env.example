# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=3000
# postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgres://skyboom_app:change_me@localhost:5432/skyboom_attendance
# Set true for most managed hosts (Render, Railway, Supabase, Neon...)
DATABASE_SSL=false
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=8
# true when the app is served over HTTPS (always in production)
COOKIE_SECURE=false
# 1 when behind a reverse proxy / hosting platform load balancer
TRUST_PROXY=0
